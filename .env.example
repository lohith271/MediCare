# Supabase (required). Browser needs the NEXT_PUBLIC_ pair; server uses the secret key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key
# Server-only. Either name works. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-secret-or-service-role-key

# LLM for document extraction (Gemini)
LLM_PROVIDER=google
LLM_API_KEY=your-gemini-api-key
LLM_MODEL=gemini-1.5-pro

# Email (optional; without it, messages are only stored in the inbox table)
RESEND_API_KEY=

# Signs share and emergency access tokens. Required. Generate with: openssl rand -base64 32
SESSION_SECRET=
